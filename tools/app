#!/usr/bin/env bash
# Build / install / launch / inspect the debug app on the attached device.
set -euo pipefail

cd "$(dirname "$0")/.."
. tools/lib/adb.sh
PKG=dev.wadackel.limenty.debug
ACTIVITY="$PKG/dev.wadackel.limenty.MainActivity"
APK=app/build/outputs/apk/debug/app-debug.apk

# Which device these act on. An emulator is usually attached alongside the phone, and once the
# phone is on the network it is attached even when it is in another room — so bare adb, which
# refuses outright when there is more than one, refuses most of the time. Name one instead of
# letting the choice fall to whichever came first. LIMENTY_AVD names an emulator by its AVD,
# which stays the same when its serial changes with start order.
attached() { "$ADB" devices | awk '$2=="device"{print $1}'; }
target() {
  if [ -n "${ANDROID_SERIAL:-}" ]; then echo "$ANDROID_SERIAL"; return; fi
  if [ -n "${LIMENTY_AVD:-}" ]; then
    avd_serial "$LIMENTY_AVD" && return
    echo "tools/app: no emulator is running $LIMENTY_AVD (LIMENTY_AVD=$LIMENTY_AVD tools/emu start)" >&2
    return 2
  fi
  local all count
  all=$(attached); count=$(echo "$all" | grep -c .)
  if [ "$count" = 1 ]; then echo "$all"; return; fi
  {
    if [ "$count" = 0 ]; then echo "tools/app: nothing attached"
    else echo "tools/app: several devices attached, so pick one:"; echo "$all" | sed 's/^/  /'; fi
    echo "  ANDROID_SERIAL=<serial> tools/app $*"
    echo "  LIMENTY_AVD=<avd> tools/app $*"
  } >&2
  return 2
}
adb_() {
  local serial
  # Stop rather than let adb pick: an install aimed at the wrong device is a wiped set of hosts.
  serial=$(target "${1:-}") || exit 2
  "$ADB" -s "$serial" "$@"
}

# Once per run, before any device is picked; target() runs in a subshell per call and could
# not remember having waited.
case "${1:-}" in build|"") ;; *) adb_settle ;; esac

case "${1:-}" in
  build)   ./gw :app:assembleDebug ;;
  install) adb_ install -r "$APK" ;;
  launch)  adb_ shell am start -n "$ACTIVITY" ;;
  stop)    adb_ shell am force-stop "$PKG" ;;
  run)     ./gw :app:assembleDebug && adb_ install -r "$APK" && adb_ logcat -c \
             && adb_ shell am start -n "$ACTIVITY" ;;
  # Only app-emitted structured lines; framework noise would bury the event sequence.
  log)     adb_ logcat -d | grep -E 'Limenty\.[A-Za-z]+:' || true ;;
  logf)    adb_ logcat | grep --line-buffered -E 'Limenty\.[A-Za-z]+:' ;;
  crash)   adb_ logcat -d -b crash | tail -60 ;;
  # The in-app ring buffer written to disk: the only log that survives a crash on a device
  # nobody was attached to. `run-as` works because the debug build is debuggable.
  dump)    dest="${2:-./artifacts/diagnostics}"; mkdir -p "$dest"
           for f in $(adb_ shell run-as "$PKG" ls files/diagnostics 2>/dev/null | tr -d '\r'); do
             adb_ shell run-as "$PKG" cat "files/diagnostics/$f" > "$dest/$f"
             echo "$dest/$f"
           done ;;
  # Instrumentation installs the app and uninstalls it when the tests end, which wipes its data —
  # the saved hosts and their credentials with it. That is a nuisance on an emulator and a real
  # loss on the phone someone actually uses, so the target has to be an emulator unless the
  # caller insists, and even then the run says what it is about to delete.
  itest)   if [ -n "${ANDROID_SERIAL:-}${LIMENTY_AVD:-}" ]; then target=$(target itest) || exit 2
           else target=$(attached | awk '/^emulator-/ {print; exit}'); target="${target:-$(attached | head -1)}"
           fi
           if [ -z "$target" ]; then
             echo "tools/app itest: no device attached" >&2; exit 2
           fi
           case "$target" in
             emulator-*) ;;
             *) if [ "${LIMENTY_ITEST_ALLOW_DEVICE:-}" != "1" ]; then
                  echo "tools/app itest: refusing to run on '$target' — this uninstalls the app when" >&2
                  echo "  the tests end, which wipes its saved hosts and credentials. Start an emulator" >&2
                  echo "  (tools/emu start) or set ANDROID_SERIAL or LIMENTY_AVD to one." >&2
                  echo "  To override anyway: LIMENTY_ITEST_ALLOW_DEVICE=1 tools/app itest" >&2
                  exit 2
                fi ;;
           esac
           echo "tools/app itest: on $target, this installs the app over what is there and uninstalls" >&2
           echo "  it when the tests end, so whatever the app had saved there (hosts, credentials," >&2
           echo "  settings) is gone afterwards. Finish any manual check on $target first." >&2
           # Anything after `itest` goes to Gradle, so one class can be run while iterating
           # (-Pandroid.testInstrumentationRunnerArguments.class=...) without going around the guard.
           shift
           # ddmlib reads ANDROID_ADB_SERVER_PORT only when it first starts in a JVM, so a warm
           # Gradle daemon could still be asking the shared server, which does not have the device.
           [ -z "${LIMENTY_ADB_PORT:-}" ] || set -- --no-daemon "$@"
           ANDROID_SERIAL="$target" ./gw :app:connectedDebugAndroidTest "$@" ;;
  devices) attached | sed "s|^|  |"; echo "commands use: $(target devices 2>/dev/null || echo '(pick one)')" ;;
  *)       echo "usage: tools/app {build|install|launch|stop|run|log|logf|crash|dump [dir]|itest [gradle args]|devices}" >&2; exit 2 ;;
esac
